{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.moai/openfhe-artifact-schema.json",
  "title": "MOAI OpenFHE run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "milestone",
    "git",
    "environment",
    "profile",
    "workload",
    "command",
    "metrics",
    "artifacts",
    "verdict"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "milestone": { "enum": ["M0", "M1", "M2", "M3", "M4", "M5", "M6"] },
    "git": {
      "type": "object",
      "required": ["commit", "branch", "dirty"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean" }
      }
    },
    "environment": { "type": "object" },
    "profile": {
      "type": "object",
      "required": ["id", "security_claim", "parameter_sha256"],
      "properties": {
        "id": { "const": "paper_compat" },
        "security_claim": { "const": "none" },
        "parameter_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "workload": { "type": "object" },
    "command": { "type": "string", "minLength": 1 },
    "metrics": {
      "type": "object",
      "properties": {
        "relative_l2": { "type": "number", "minimum": 0 },
        "cosine_similarity": { "type": "number", "minimum": -1, "maximum": 1 },
        "max_absolute_error": { "type": "number", "minimum": 0 },
        "latency_ms": { "type": "number", "minimum": 0 },
        "peak_rss_bytes": { "type": "integer", "minimum": 0 },
        "rotations": { "type": "integer", "minimum": 0 },
        "ct_pt_multiplications": { "type": "integer", "minimum": 0 },
        "ct_ct_multiplications": { "type": "integer", "minimum": 0 },
        "multiplicative_depth": { "type": "integer", "minimum": 0 },
        "bootstraps": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "verdict": { "enum": ["GO", "NO-GO", "BLOCKED", "SOURCE_AUDIT_ONLY"] }
  }
}
